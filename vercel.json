{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "includeFiles": "{feed,data,router}/**"
    }
  },
  "rewrites": [
    { "source": "/api/prices.json", "destination": "/feed/prices.json" },
    { "source": "/api/prices", "destination": "/feed/prices.json" }
  ],
  "headers": [
    {
      "source": "/feed/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
